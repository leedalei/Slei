{
  "name": "@slei/desktop",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420",
    "desktop": "scripts/desktop-dev.sh",
    "build": "tsc -p tsconfig.json && vite build",
    "generate:default-agent-assets": "node ../../scripts/generate-default-agent-assets.mjs",
    "check:default-agent-assets": "node ../../scripts/generate-default-agent-assets.mjs --check",
    "test": "vitest run",
    "test:e2e": "vitest run",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@dicebear/collection": "^9.4.2",
    "@dicebear/core": "^9.4.2",
    "@fontsource-variable/outfit": "^5.2.8",
    "@slei/i18n": "workspace:*",
    "@slei/protocol-client": "workspace:*",
    "@tauri-apps/api": "2.11.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.17.0",
    "radix-ui": "^1.4.3",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-markdown": "^10.1.0",
    "react-router": "^7.17.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@tauri-apps/cli": "2.11.2",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "jsdom": "^29.1.1",
    "shadcn": "^4.10.0",
    "tailwindcss": "^4.3.0",
    "vite": "^7.3.3"
  }
}
