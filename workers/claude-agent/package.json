{
  "name": "@slei/claude-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "slei-claude-agent": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit false --outDir dist",
    "bundle:desktop": "node ../../apps/desktop/scripts/bundle-claude-worker.mjs",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "slei": {
    "workerHealthArg": "--slei-worker-health",
    "distribution": "standalone-artifact"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.100.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^4.4.3"
  }
}
